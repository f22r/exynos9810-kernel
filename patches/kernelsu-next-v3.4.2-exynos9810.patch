+static int sepol_copy_legacy_payload(void __user *user_data, u8 **payload,
+                                     u64 *data_len)
+{
+    struct {
+        u32 cmd;
+        u32 subcmd;
+        u64 args[7];
+    } legacy;
+    u8 *buffer, *cursor;
+    int argc, i;
+    long len;
+    u32 wire_len;
+
+    if (copy_from_user(&legacy, user_data, sizeof(legacy)))
+        return -EFAULT;
+    argc = sepol_expected_argc(legacy.cmd);
+    if (argc < 0 || argc > KSU_SEPOLICY_MAX_ARGS)
+        return -EINVAL;
+
+    /* Original ABI limits each argument to a 128-byte NUL-terminated buffer. */
+    buffer = kmalloc(sizeof(struct sepol_data) + argc * (sizeof(u32) + 128),
+                     GFP_KERNEL);
+    if (!buffer)
+        return -ENOMEM;
+    memcpy(buffer, &legacy, sizeof(struct sepol_data));
+    cursor = buffer + sizeof(struct sepol_data);
+    for (i = 0; i < argc; i++) {
+        len = 0;
+        if (legacy.args[i]) {
+            len = strncpy_from_user((char *)cursor + sizeof(u32),
+                    (const char __user *)(unsigned long)legacy.args[i], 128);
+            if (len < 0 || len >= 128) {
+                kfree(buffer);
+                return len < 0 ? (int)len : -E2BIG;
+            }
+        }
+        wire_len = (u32)len;
+        memcpy(cursor, &wire_len, sizeof(wire_len));
+        cursor += sizeof(wire_len);
+        cursor[len] = '\0';
+        cursor += len + 1;
+    }
+    *payload = buffer;
+    *data_len = cursor - buffer;
+    return 0;
+}
