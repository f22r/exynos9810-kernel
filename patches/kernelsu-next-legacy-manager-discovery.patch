 uid_t ksu_manager_appid = KSU_INVALID_APPID;
+static DEFINE_MUTEX(ksu_throne_scan_mutex);
 
 #define SYSTEM_PACKAGES_LIST_PATH "/data/system/packages.list"
 
@@ -262,7 +264,10 @@ static bool is_uid_exist(uid_t uid, char *package, void *data)
 
 void track_throne(bool prune_only)
 {
-	const struct cred *old_cred = override_creds(ksu_cred);
+	const struct cred *old_cred;
+
+	mutex_lock(&ksu_throne_scan_mutex);
+	old_cred = override_creds(ksu_cred);
 	struct file *fp = filp_open(SYSTEM_PACKAGES_LIST_PATH, O_RDONLY, 0);
 	if (IS_ERR(fp)) {
 		pr_err("%s: open " SYSTEM_PACKAGES_LIST_PATH " failed: %ld\n", __func__,
@@ -358,6 +363,7 @@ out:
 	}
 out_revert_cred:
 	revert_creds(old_cred);
+	mutex_unlock(&ksu_throne_scan_mutex);
 }
 
 void __init ksu_throne_tracker_init()
@@ -373,4 +379,4 @@ void __init ksu_throne_tracker_init()
 void __exit ksu_throne_tracker_exit()
 {
 	// nothing to do
-}
\ No newline at end of file
